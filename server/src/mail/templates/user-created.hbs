<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Account Has Been Created</title>
  <style>
    /* Reset & Base */
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background-color: #1a1a1a;
      color: #e5e5e5;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 24px 16px;
    }
    .email-wrapper {
      background-color: #262626;
      border-radius: 16px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
      overflow: hidden;
      border: 1px solid #404040;
    }
    /* Header */
    .header {
      background: linear-gradient(135deg, #d97706 0%, #b45309 50%, #92400e 100%);
      padding: 32px 24px;
      text-align: center;
    }
    .logo {
      width: 56px;
      height: 56px;
      margin-bottom: 16px;
    }
    .header h1 {
      color: #ffffff;
      margin: 0;
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    /* Content */
    .content {
      padding: 32px 24px;
    }
    .greeting {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 16px;
      color: #f5f5f5;
    }
    .message {
      margin-bottom: 24px;
      color: #a3a3a3;
      font-size: 16px;
    }
    .message strong {
      color: #d97706;
    }
    /* Account Details Card */
    .account-details {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(16, 185, 129, 0.05) 100%);
      border-left: 4px solid #10b981;
      border-radius: 0 12px 12px 0;
      padding: 20px;
      margin: 24px 0;
    }
    .account-details p {
      margin: 10px 0;
      color: #d4d4d4;
      font-size: 15px;
    }
    .account-details strong {
      color: #10b981;
      font-weight: 600;
    }
    /* CTA Button */
    .cta-button {
      display: inline-block;
      background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
      color: #ffffff !important;
      text-decoration: none;
      padding: 16px 40px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 16px;
      margin: 24px 0;
      text-align: center;
      box-shadow: 0 4px 14px rgba(217, 119, 6, 0.35);
    }
    /* Security Notice */
    .security-notice {
      background-color: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 10px;
      padding: 16px 20px;
      margin: 24px 0;
      font-size: 14px;
      color: #93c5fd;
    }
    .security-notice strong {
      color: #60a5fa;
    }
    /* Footer */
    .footer {
      background-color: #1f1f1f;
      padding: 24px;
      text-align: center;
      font-size: 13px;
      color: #737373;
      border-top: 1px solid #333333;
    }
    .footer a {
      color: #d97706;
      text-decoration: none;
    }
    .footer a:hover {
      text-decoration: underline;
    }
    /* Divider */
    .divider {
      border: none;
      border-top: 1px solid #404040;
      margin: 24px 0;
    }
    /* Helper Text */
    .helper-text {
      font-size: 14px;
      color: #737373;
    }
    .helper-text a {
      color: #d97706;
      text-decoration: none;
    }
    /* Responsive */
    @media only screen and (max-width: 600px) {
      .container {
        padding: 12px;
      }
      .content {
        padding: 24px 16px;
      }
      .cta-button {
        display: block;
        text-align: center;
      }
      .header h1 {
        font-size: 20px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="email-wrapper">
      <!-- Header -->
      <div class="header">
        <img src="{{logoUrl}}" alt="Signify iD" class="logo" />
        <h1>🔐 Your Account is Ready</h1>
      </div>

      <!-- Content -->
      <div class="content">
        <p class="greeting">Hello {{recipientName}},</p>
        
        <p class="message">
          An account has been created for you at <strong>{{organizationName}}</strong> 
          on Signify iD, our secure identity and access management platform.
        </p>

        <div class="account-details">
          <p><strong>Email:</strong> {{recipientEmail}}</p>
          <p><strong>Organization:</strong> {{organizationName}}</p>
          <p><strong>Role:</strong> {{roleName}}</p>
          {{#if createdByName}}
          <p><strong>Created by:</strong> {{createdByName}}</p>
          {{/if}}
        </div>

        <p class="message">
          Your account is ready to use. Click the button below to log in:
        </p>

        <div style="text-align: center;">
          <a href="{{loginLink}}" class="cta-button">Log In Now</a>
        </div>

        <div class="security-notice">
          <strong>🔒 Security Tip:</strong> We recommend enabling Multi-Factor Authentication (MFA) 
          after your first login for enhanced account security.
        </div>

        <hr class="divider">

        <p class="helper-text">
          If you didn't expect this account creation, please contact your administrator 
          or reach out to us at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>© {{year}} Signify iD. All rights reserved.</p>
        <p>
          This email was sent to {{recipientEmail}}.<br>
          <a href="{{frontendUrl}}">Visit Signify iD</a>
        </p>
      </div>
    </div>
  </div>
</body>
</html>
