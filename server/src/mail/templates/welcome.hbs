<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to Signify iD</title>
  <style>
    /* Reset & Base */
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background-color: #1a1a1a;
      color: #e5e5e5;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 24px 16px;
    }
    .email-wrapper {
      background-color: #262626;
      border-radius: 16px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
      overflow: hidden;
      border: 1px solid #404040;
    }
    /* Header */
    .header {
      background: linear-gradient(135deg, #059669 0%, #047857 50%, #065f46 100%);
      padding: 40px 24px;
      text-align: center;
    }
    .logo {
      width: 56px;
      height: 56px;
      margin-bottom: 16px;
    }
    .header h1 {
      color: #ffffff;
      margin: 0 0 8px 0;
      font-size: 28px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .header p {
      color: rgba(255, 255, 255, 0.9);
      margin: 0;
      font-size: 16px;
    }
    /* Content */
    .content {
      padding: 32px 24px;
    }
    .greeting {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 16px;
      color: #f5f5f5;
    }
    .message {
      margin-bottom: 24px;
      color: #a3a3a3;
      font-size: 16px;
    }
    .message strong {
      color: #d97706;
    }
    /* Highlight Box */
    .highlight-box {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(16, 185, 129, 0.05) 100%);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: 12px;
      padding: 24px;
      margin: 24px 0;
      text-align: center;
    }
    .highlight-box h3 {
      color: #10b981;
      margin: 0 0 8px 0;
      font-size: 18px;
      font-weight: 600;
    }
    .highlight-box p {
      color: #6ee7b7;
      margin: 0;
      font-size: 15px;
    }
    /* Features List */
    .features-list {
      list-style: none;
      padding: 0;
      margin: 24px 0;
    }
    .features-list li {
      padding: 14px 0;
      border-bottom: 1px solid #333333;
      display: flex;
      align-items: center;
      color: #d4d4d4;
      font-size: 15px;
    }
    .features-list li:last-child {
      border-bottom: none;
    }
    .features-list .icon {
      width: 24px;
      margin-right: 12px;
      font-size: 16px;
      color: #10b981;
    }
    /* CTA Button */
    .cta-button {
      display: inline-block;
      background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
      color: #ffffff !important;
      text-decoration: none;
      padding: 16px 40px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 16px;
      margin: 16px 0;
      box-shadow: 0 4px 14px rgba(217, 119, 6, 0.35);
    }
    .secondary-button {
      display: inline-block;
      background-color: transparent;
      color: #d97706 !important;
      text-decoration: none;
      padding: 14px 28px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 14px;
      border: 2px solid #d97706;
      margin: 8px;
    }
    .buttons-row {
      text-align: center;
      margin: 24px 0;
    }
    /* Tips Section */
    .tips-section {
      background-color: #1f1f1f;
      border-radius: 12px;
      padding: 24px;
      margin: 24px 0;
      border: 1px solid #333333;
    }
    .tips-section h4 {
      margin: 0 0 16px 0;
      color: #f5f5f5;
      font-size: 16px;
      font-weight: 600;
    }
    .tips-section ul {
      margin: 0;
      padding-left: 20px;
      color: #a3a3a3;
    }
    .tips-section li {
      margin: 10px 0;
      font-size: 14px;
    }
    /* Footer */
    .footer {
      background-color: #1f1f1f;
      padding: 24px;
      text-align: center;
      font-size: 13px;
      color: #737373;
      border-top: 1px solid #333333;
    }
    .footer a {
      color: #d97706;
      text-decoration: none;
    }
    .footer a:hover {
      text-decoration: underline;
    }
    /* Divider */
    .divider {
      border: none;
      border-top: 1px solid #404040;
      margin: 24px 0;
    }
    /* Helper Text */
    .helper-text {
      font-size: 14px;
      color: #737373;
      text-align: center;
    }
    .helper-text a {
      color: #d97706;
      text-decoration: none;
    }
    /* Responsive */
    @media only screen and (max-width: 600px) {
      .container {
        padding: 12px;
      }
      .content {
        padding: 24px 16px;
      }
      .cta-button, .secondary-button {
        display: block;
        text-align: center;
        margin: 8px 0;
      }
      .header h1 {
        font-size: 24px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="email-wrapper">
      <!-- Header -->
      <div class="header">
        <img src="{{logoUrl}}" alt="Signify iD" class="logo" />
        <h1>🎉 Welcome!</h1>
        <p>Your journey with Signify iD begins now</p>
      </div>

      <!-- Content -->
      <div class="content">
        <p class="greeting">Hello {{recipientName}},</p>
        
        {{#if isOrgWelcome}}
        <p class="message">
          Congratulations! Your organization <strong>{{organizationName}}</strong> has been 
          successfully created on Signify iD. You're now ready to secure your identity 
          and access management.
        </p>

        <div class="highlight-box">
          <h3>🏢 Organization Created</h3>
          <p>{{organizationName}} is ready to go!</p>
        </div>
        {{else}}
        <p class="message">
          Welcome to <strong>{{organizationName}}</strong> on Signify iD! Your account 
          has been set up and you're ready to get started with our secure identity 
          and access management platform.
        </p>

        <div class="highlight-box">
          <h3>✅ Account Ready</h3>
          <p>You're all set to access {{organizationName}}</p>
        </div>
        {{/if}}

        <div class="buttons-row">
          <a href="{{dashboardLink}}" class="cta-button">Go to Dashboard</a>
        </div>

        {{#if features}}
        <ul class="features-list">
          {{#each features}}
          <li>
            <span class="icon">✓</span>
            <span>{{this}}</span>
          </li>
          {{/each}}
        </ul>
        {{/if}}

        <div class="tips-section">
          <h4>🚀 Getting Started</h4>
          <ul>
            <li>Set up Multi-Factor Authentication (MFA) for extra security</li>
            <li>Review your organization's security settings</li>
            <li>Invite team members to collaborate</li>
            <li>Check out our documentation for best practices</li>
          </ul>
        </div>

        <div class="buttons-row">
          <a href="{{docsLink}}" class="secondary-button">📚 Read Documentation</a>
        </div>

        <hr class="divider">

        <p class="helper-text">
          Need help? Our support team is here for you.<br>
          Contact us at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>© {{year}} Signify iD. All rights reserved.</p>
        <p>
          <a href="{{frontendUrl}}">Visit Signify iD</a> | 
          <a href="{{docsLink}}">Documentation</a>
        </p>
      </div>
    </div>
  </div>
</body>
</html>
