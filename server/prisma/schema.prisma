generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  engineType    = "library"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        String        @db.Uuid
  user_id       String?       @db.Uuid
  action        String
  meta          Json?
  created_at    DateTime?     @default(now()) @db.Timestamptz(6)
  organizations organizations @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users?        @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([org_id], map: "idx_logs_org")
  @@index([user_id], map: "idx_logs_user")
}

model authorization_codes {
  code                  String    @id
  client_id             String    @db.Uuid
  user_id               String    @db.Uuid
  redirect_uri          String
  scopes                String[]
  code_challenge        String?
  code_challenge_method String?
  nonce                 String?
  expires_at            DateTime  @db.Timestamptz(6)
  used                  Boolean?  @default(false)
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  clients               clients   @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([client_id], map: "idx_auth_codes_client")
  @@index([expires_at], map: "idx_auth_codes_expires")
  @@index([user_id], map: "idx_auth_codes_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model client_sessions {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id          String         @db.Uuid
  session_token_hash String         @unique
  domain             String
  ip_address         String?
  device_fingerprint String?
  created_at         DateTime?      @default(now()) @db.Timestamptz(6)
  last_activity_at   DateTime?      @default(now()) @db.Timestamptz(6)
  expires_at         DateTime       @db.Timestamptz(6)
  revoked            Boolean?       @default(false)
  org_id             String?        @db.Uuid
  user_agent         String?
  clients            clients        @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations      organizations? @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([client_id], map: "idx_client_sessions_client")
  @@index([expires_at], map: "idx_client_sessions_expires")
  @@index([org_id], map: "idx_client_sessions_org")
  @@index([revoked], map: "idx_client_sessions_revoked")
  @@index([session_token_hash], map: "idx_client_sessions_token")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model clients {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id              String                @db.Uuid
  client_id           String                @unique
  client_secret_hash  String?
  redirect_uris       String[]
  scopes              String[]
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  name                String?
  is_active           Boolean?              @default(true)
  allowed_domains     String[]
  status              String?               @default("active")
  project_type        String?               @default("website")
  authorization_codes authorization_codes[]
  client_sessions     client_sessions[]
  organizations       organizations         @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sessions            sessions[]
  tokens              tokens[]

  @@index([client_id], map: "idx_clients_client_id")
  @@index([org_id], map: "idx_clients_org")
  @@index([project_type], map: "idx_clients_project_type")
  @@index([status], map: "idx_clients_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model devices {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  fingerprint_hash String
  last_seen_ip     String?
  last_seen_at     DateTime? @db.Timestamptz(6)
  risk_score       Decimal?  @default(0) @db.Decimal
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, fingerprint_hash])
  @@index([user_id], map: "idx_devices_user")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model invite_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @unique @db.Uuid
  token      String    @unique @db.VarChar(64)
  expires_at DateTime  @default(dbgenerated("(now() + '7 days'::interval)")) @db.Timestamp(6)
  used_at    DateTime? @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_invite_tokens_expires_at")
  @@index([token], map: "idx_invite_tokens_token")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model mfa_methods {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  type       String
  secret     String?
  verified   Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_mfa_user")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model organizations {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  domain             String?              @unique
  plan               String?              @default("free")
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  meta               Json?                @default("{}")
  audit_logs         audit_logs[]
  client_sessions    client_sessions[]
  clients            clients[]
  roles              roles[]
  sessions           sessions[]
  users              users[]
  workflows          workflows[]
  identity_providers identity_providers[]
  subscription       subscriptions?
  email_logs         email_logs[]
}

/// Stripe subscription tracking for billing
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model subscriptions {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id                 String        @unique @db.Uuid
  stripe_customer_id     String        @unique
  stripe_subscription_id String?       @unique
  status                 String        @default("inactive") // active, canceled, past_due, trialing, inactive
  plan                   String        @default("free") // free, starter, professional, enterprise
  current_period_start   DateTime?     @db.Timestamptz(6)
  current_period_end     DateTime?     @db.Timestamptz(6)
  cancel_at_period_end   Boolean?      @default(false)
  created_at             DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?     @default(now()) @db.Timestamptz(6)
  organizations          organizations @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@index([org_id], map: "idx_subscriptions_org")
  @@index([stripe_customer_id], map: "idx_subscriptions_customer")
  @@index([status], map: "idx_subscriptions_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model risk_events {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  event_type String
  features   Json?
  risk_score Decimal?  @db.Decimal
  decision   String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_risk_user")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model roles {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id         String        @db.Uuid
  name           String
  permissions    String[]
  description    String?
  is_system_role Boolean?      @default(false)
  created_by     String?       @db.Uuid
  created_at     DateTime?     @default(now()) @db.Timestamptz(6)
  users          users?        @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  organizations  organizations @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_roles     user_roles[]

  @@unique([org_id, name])
  @@index([org_id], map: "idx_roles_org")
  @@index([is_system_role], map: "idx_roles_system")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sessions {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String        @db.Uuid
  client_id        String?       @db.Uuid
  device_info      Json?
  ip_address       String?
  created_at       DateTime?     @default(now()) @db.Timestamptz(6)
  expires_at       DateTime?     @db.Timestamptz(6)
  revoked          Boolean?      @default(false)
  org_id           String        @db.Uuid
  mfa_verified     Boolean?      @default(false)
  user_agent       String?
  last_activity_at DateTime?     @default(now()) @db.Timestamptz(6)
  clients          clients?      @relation(fields: [client_id], references: [id], onUpdate: NoAction)
  organizations    organizations @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([last_activity_at(sort: Desc)], map: "idx_sessions_activity")
  @@index([client_id], map: "idx_sessions_client")
  @@index([org_id], map: "idx_sessions_org")
  @@index([org_id, user_id], map: "idx_sessions_org_user")
  @@index([user_id], map: "idx_sessions_user")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tokens {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  client_id          String?   @db.Uuid
  refresh_token_hash String
  issued_at          DateTime? @default(now()) @db.Timestamptz(6)
  expires_at         DateTime? @db.Timestamptz(6)
  revoked            Boolean?  @default(false)
  clients            clients?  @relation(fields: [client_id], references: [id], onUpdate: NoAction)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([client_id], map: "idx_tokens_client")
  @@index([user_id], map: "idx_tokens_user")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_roles {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  role_id     String    @db.Uuid
  assigned_at DateTime? @default(now()) @db.Timestamptz(6)
  roles       roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, role_id])
  @@index([role_id], map: "idx_user_roles_role")
  @@index([user_id], map: "idx_user_roles_user")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id              String                @db.Uuid
  email               String                @unique
  password_hash       String
  display_name        String?
  status              String?               @default("active")
  google_id           String?               @unique
  auth_provider       String?               @default("email")
  last_login_at       DateTime?             @db.Timestamptz(6)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  audit_logs          audit_logs[]
  authorization_codes authorization_codes[]
  devices             devices[]
  invite_tokens       invite_tokens?
  mfa_methods         mfa_methods[]
  risk_events         risk_events[]
  roles               roles[]
  sessions            sessions[]
  tokens              tokens[]
  user_roles          user_roles[]
  organizations       organizations         @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workflows           workflows[]
  email_logs          email_logs[]
  passkey_credentials passkey_credentials[]

  @@index([email], map: "idx_users_email")
  @@index([org_id], map: "idx_users_org")
  @@index([google_id], map: "idx_users_google_id")
  @@index([auth_provider], map: "idx_users_auth_provider")
}

/// Passkey credentials for WebAuthn/FIDO2 authentication
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model passkey_credentials {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String    @db.Uuid
  credential_id        String    @unique // Base64URL encoded credential ID
  public_key           String // Base64URL encoded public key
  counter              BigInt    @default(0) // Signature counter for anti-replay
  transports           String[] // ['internal', 'usb', 'ble', 'nfc']
  device_name          String?   @db.VarChar(255) // User-friendly name
  authenticator_aaguid String? // Authenticator identifier
  backed_up            Boolean?  @default(false) // iCloud Keychain, etc.
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  last_used_at         DateTime? @db.Timestamptz(6)
  users                users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_passkeys_user")
  @@index([credential_id], map: "idx_passkeys_credential")
}

/// Identity providers for enterprise SSO configuration
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model identity_providers {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id                  String        @db.Uuid
  type                    String        @db.VarChar(20)
  name                    String        @db.VarChar(255)
  domain                  String        @db.VarChar(255)
  client_id               String?       @db.VarChar(255)
  client_secret_encrypted String?
  issuer_url              String?
  authorization_endpoint  String?
  token_endpoint          String?
  userinfo_endpoint       String?
  jwks_uri                String?
  metadata                Json?         @default("{}")
  is_active               Boolean?      @default(true)
  created_at              DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?     @default(now()) @db.Timestamptz(6)
  organizations           organizations @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([org_id, domain])
  @@index([domain], map: "idx_idp_domain")
  @@index([org_id], map: "idx_idp_org")
  @@index([type], map: "idx_idp_type")
  @@index([is_active], map: "idx_idp_active")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model workflows {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id        String        @db.Uuid
  name          String        @db.VarChar(255)
  description   String?
  status        String        @default("draft") @db.VarChar(50)
  graph_json    Json          @default("{\"edges\": [], \"nodes\": []}")
  created_by    String        @db.Uuid
  created_at    DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?     @default(now()) @db.Timestamptz(6)
  published_at  DateTime?     @db.Timestamptz(6)
  users         users         @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations organizations @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_by], map: "idx_workflows_created_by")
  @@index([graph_json], map: "idx_workflows_graph", type: Gin)
  @@index([org_id], map: "idx_workflows_org_id")
  @@index([org_id, status], map: "idx_workflows_org_status")
  @@index([status], map: "idx_workflows_status")
}

/// Email logs for auditing all transactional emails
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model email_logs {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id          String        @db.Uuid
  user_id         String?       @db.Uuid
  email_type      String        @db.VarChar(50)
  recipient       String        @db.VarChar(255)
  subject         String?       @db.VarChar(500)
  status          String        @default("pending") @db.VarChar(20)
  error_message   String?
  retry_count     Int           @default(0)
  idempotency_key String?       @unique @db.VarChar(255)
  metadata        Json?         @default("{}")
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  sent_at         DateTime?     @db.Timestamptz(6)
  organizations   organizations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  users           users?        @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([org_id], map: "idx_email_logs_org")
  @@index([user_id], map: "idx_email_logs_user")
  @@index([email_type], map: "idx_email_logs_type")
  @@index([status], map: "idx_email_logs_status")
  @@index([created_at(sort: Desc)], map: "idx_email_logs_created")
}
