# ==============================================================================
# SIGNIFY iD - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual values
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# URL of the frontend application (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE (Prisma)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/signifyid?schema=public"

# Direct connection string (required for migrations if using connection pooling)
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/signifyid?schema=public"

# ------------------------------------------------------------------------------
# REDIS (Caching & Rate Limiting)
# ------------------------------------------------------------------------------
# Redis connection URL
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=signifyid:

# ------------------------------------------------------------------------------
# SECURITY & TOKENS
# ------------------------------------------------------------------------------
# JWT Secrets (Must be at least 32 chars in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production

# Token Expiry Durations
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d
JWT_RESET_PASSWORD_EXPIRES=10m
JWT_VERIFY_EMAIL_EXPIRES=10m
JWT_ALGORITHM=HS256

# Cookie Security
# Set to 'true' in production (requires HTTPS)
COOKIE_SECURE=false
# SameSite policy: 'Lax', 'Strict', or 'None' (None requires Secure=true)
COOKIE_SAMESITE=Lax
COOKIE_ACCESS_EXPIRES=900000        # 15 minutes in ms
COOKIE_REFRESH_EXPIRES=604800000    # 7 days in ms

# ------------------------------------------------------------------------------
# GOOGLE OAUTH
# ------------------------------------------------------------------------------
# Create project at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ------------------------------------------------------------------------------
# SINGLE SIGN-ON (SSO)
# ------------------------------------------------------------------------------
SSO_CALLBACK_URL=http://localhost:5000/api/auth/sso/callback

# ------------------------------------------------------------------------------
# STRIPE (Billing)
# ------------------------------------------------------------------------------
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Product Price IDs
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PROFESSIONAL_PRICE_ID=price_...

# ------------------------------------------------------------------------------
# WEBAUTHN / PASSKEYS
# ------------------------------------------------------------------------------
# Relying Party ID (hostname without port)
WEBAUTHN_RP_ID=localhost
# Origin (full URL including protocol and port)
WEBAUTHN_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# MAIL (SMTP)
# ------------------------------------------------------------------------------
# SMTP Configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set to 'true' for port 465, 'false' for 587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=noreply@signifyid.com
SMTP_FROM_NAME="Signify iD"
