{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/.well-known/(.*)",
      "dest": "/api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/email-retry",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/audit-summary",
      "schedule": "0 9 * * 0"
    }
  ]
}
