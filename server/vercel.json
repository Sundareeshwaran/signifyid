{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.ts"
    },
    {
      "src": "/api/cron/(.*)",
      "dest": "/api/cron/$1.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/.well-known/(.*)",
      "dest": "/api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/email-retry",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/audit-summary",
      "schedule": "0 9 * * 0"
    }
  ]
}
