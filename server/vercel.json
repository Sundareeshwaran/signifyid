{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ],
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health.ts" },
    {
      "source": "/api/cron/email-retry",
      "destination": "/api/cron/email-retry.ts"
    },
    {
      "source": "/api/cron/audit-summary",
      "destination": "/api/cron/audit-summary.ts"
    },
    {
      "source": "/api/internal/redis-health",
      "destination": "/api/internal/redis-health.ts"
    },
    { "source": "/api/:path(.*)", "destination": "/api/index.ts" },
    { "source": "/.well-known/:path(.*)", "destination": "/api/index.ts" }
  ],
  "crons": [
    {
      "path": "/api/cron/email-retry",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/audit-summary",
      "schedule": "0 9 * * 0"
    }
  ]
}
