# ==============================================================================
# SIGNIFY iD - FRONTEND ENVIRONMENT CONFIGURATION (Next.js)
# ==============================================================================
# Copy this file to .env.local and fill in your actual values
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# ==============================================================================


# ------------------------------------------------------------------------------
# API CONFIGURATION
# ------------------------------------------------------------------------------

# Backend API URL
# Local: http://localhost:5000/api
# Production: https://signifyid-api.vercel.app/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api


# ------------------------------------------------------------------------------
# SIGNIFY SDK CONFIGURATION
# ------------------------------------------------------------------------------

# Signify API URL (used in SDK documentation examples)
# Local: http://localhost:5000
# Production: https://signifyid-api.vercel.app
NEXT_PUBLIC_SIGNIFY_API_URL=http://localhost:5000

# Signify Login URL for client-side authentication
# Local: http://localhost:3000/client/login
# Production: https://signifyid.vercel.app/client/login
NEXT_PUBLIC_SIGNIFY_LOGIN_URL=http://localhost:3000/client/login


# ------------------------------------------------------------------------------
# STRIPE BILLING (Public Keys Only)
# ------------------------------------------------------------------------------

# Stripe Publishable Key (safe to expose to client)
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Price IDs for frontend checkout
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_starter_plan_id
NEXT_PUBLIC_STRIPE_PROFESSIONAL_PRICE_ID=price_professional_plan_id


# ==============================================================================
# PRODUCTION NOTES
# ==============================================================================
# - All NEXT_PUBLIC_ variables are bundled into the client-side code
# - Never expose secret keys (sk_*, webhook secrets, etc.) in frontend
# - Update API URLs to production URLs when deploying
# - Use production Stripe keys (pk_live_*) for production
# ==============================================================================